<UserControl
    x:Class="SnapIt.Controls.SnapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="600"
    ClipToBounds="True"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="MainAreas" />
        <Grid x:Name="MainGrid" />
        <Grid x:Name="MainFullOverlay" />
        <Grid x:Name="MainOverlay" />

        <Border
            x:Name="SelectionBar"
            Margin="0,0,0,16"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="999"
            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="已选择 " />
                <TextBlock
                    x:Name="SelectedCountText"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="0" />

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text=" 个区域" />
                <ui:Button
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Click="ConfirmAreaSelect_Click"
                    Content="✓ Create Overlay"
                    FontWeight="Bold"
                    Foreground="White"
                    Icon="Checkmark24" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Click="CancelAreaSelect_Click"
                    Content="✕ Cancel"
                    Icon="Dismiss24" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>